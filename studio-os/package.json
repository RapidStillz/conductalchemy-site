{
  "name": "studio-os-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "npm run validate:components && esbuild src/worker.ts --bundle --format=esm --platform=browser --outfile=.validation/worker.js",
    "validate:components": "node scripts/validate-components.mjs",
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "db:migrate:local": "wrangler d1 migrations apply studio-os-dev --local --config wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply studio-os-dev --remote --config wrangler.toml"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "wrangler": "^4.0.0"
  }
}
